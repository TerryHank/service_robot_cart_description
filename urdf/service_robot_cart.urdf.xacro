<?xml version="1.0"?>
<robot name="service_robot_cart" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include the geometric model -->
  <xacro:include filename="$(find service_robot_cart_description)/urdf/service_robot_cart_geometric.urdf.xacro"/>

  <!-- ros2_control hardware interface (inline, not included) -->
  <ros2_control name="mock_components" type="system">
    <hardware>
      <plugin>mock_components/System</plugin>
      <param name="front_left_wheel_joint">position</param>
      <param name="front_right_wheel_joint">position</param>
      <param name="rear_left_wheel_joint">position</param>
      <param name="rear_right_wheel_joint">position</param>
    </hardware>

    <joint name="front_left_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_right_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_left_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
